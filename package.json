{
  "name": "blockhold-launcher",
  "productName": "Blockhold Launcher",
  "version": "0.1.2",
  "description": "A voxel-world desktop game launcher: walk around, find your games in chests, launch them.",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist/main --target=node22 --sourcemap",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {},
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "author": "Blockhold",
  "build": {
    "appId": "app.blockhold.launcher",
    "productName": "Blockhold Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blockhold Launcher"
    },
    "portable": {
      "artifactName": "BlockholdLauncher-${version}-portable.exe"
    }
  }
}
